{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin",
  "version": "0.1.0",
  "identifier": "io.github.adrian-z-wong.margin",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Margin",
        "width": 1100,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "黑白极简的背单词工具",
    "copyright": "© 2026 Adrian-Z-Wong",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
