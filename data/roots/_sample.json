 {"type":"root","forms":["port"],"meaning":"运，携带","origin":"拉丁语 portare「运」","note":"","examples":[{"w":"export","parts":"ex(向外) + port(运)","m":"出口"},{"w":"portfolio","parts":"port(携带) + folio(纸页)","m":"投资组合"},{"w":"transport","parts":"trans(穿过) + port(运)","m":"运输"}]},
 {"type":"suffix","forms":["able","ible"],"meaning":"能…的，可…的","origin":"拉丁语 -abilis","note":"","examples":[{"w":"readable","parts":"read(读) + able(能…的)","m":"易读的"},{"w":"visible","parts":"vis(看) + ible(能…的)","m":"看得见的"},{"w":"sustainable","parts":"sustain(维持) + able(能…的)","m":"可持续的"}]}
